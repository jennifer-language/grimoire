/**
 * The Grimoire launcher: the command a reader types.
 *
 * All it does is say where Grimoire is installed and hand the command line to
 * `src/main.j`, which is the actual program. The import is resolved relative to
 * this file by the interpreter, so the launcher runs correctly from any working
 * directory and through any symlink.
 * @module grimoire
 * @author mplx <jennifer@mplx.dev>
 * @license LGPL-3.0-only
 */
use fs;
use os;
use path;

import "./src/main.j" as main;

# Where Grimoire's own bundled assets live, from the path this file was invoked
# by. That path is resolved through any symlinks first: `ln -s /opt/grimoire/grimoire
# ~/bin/grimoire` is how a command gets onto a PATH, and the assets ship beside
# the real file rather than beside the link. An unresolvable path falls back to
# the invocation path - a book still builds; only the bundled highlight.js
# grammar would be missed, and the build says so when it is.
func appDir(invoked as string) {
    def real as string init $invoked;
    try {
        $real = fs.realpath($invoked);
    } catch (e) {
        $real = $invoked;
    }
    return path.join(path.dir($real), "src");
}

exit main.run(appDir(os.ARGS[0]), os.ARGS);
