# base strips the region from a language tag, so `de-AT` is German and `pt-BR` is
# Portuguese. `src/locale.j` has the same three lines for the interface catalogs;
# they are apart because these two lookups answer different questions - the
# language a book is *written* in, and the language its chrome is rendered in -
# and `html.uiLanguage` exists precisely so a book can set them differently.
func base(lang as string) {
    def at as int init strings.indexOf($lang, "-");
    if ($at < 0) {
        return strings.lower($lang);
    }
    return strings.lower(strings.substring($lang, 0, $at));
}

# catalog is the list for one base tag, empty for a language with no list -
# including English, which `forLanguage` has already added.
func catalog(tag as string) {
    match ($tag) {
        when "de" { return DE; }
        when "es" { return ES; }
        when "fr" { return FR; }
        when "it" { return IT; }
        when "nl" { return NL; }
        when "pl" { return PL; }
        when "pt" { return PT; }
        when "ru" { return RU; }
        else {
            def empty as list of string;
            return $empty;
        }
    }
}

/**
 * The languages there is a stop list for, English first.
 * @return {list of string} the language tags
 */
export func names() {
    return LANGUAGES;
}

/**
 * Whether a language tag is one there is a stop list for, beyond the English
 * that every book gets. A tag with a region counts if its base language does.
 * @param lang {string} the language tag from the configuration
 * @return {bool} whether the book's own language contributes a list
 */
export func has(lang as string) {
    return lists.contains(LANGUAGES, base($lang));
}

/**
 * The stop words for a book written in one language: English, the code
 * literals, and the book's own language when there is a list for it.
 *
 * An unknown tag is not an error and is not reported. A book in a language
 * nobody has written a list for keeps the English one, which is the same
 * outcome `src/locale.j` gives its chrome, and `keywordStopwords` is where its
 * author fills the gap.
 * @param lang {string} the book's language tag, from `book.language`
 * @return {list of string} the stop words, in no particular order
 */
export func forLanguage(lang as string) {
    def out as list of string init EN;
    for (def word in LITERALS) {
        $out[] = $word;
    }
    for (def word in catalog(base($lang))) {
        $out[] = $word;
    }
    return $out;
}
