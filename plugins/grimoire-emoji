/**
 * The launcher: hand the request on stdin to `emoji.run` and exit its status.
 * Everything else is in the module, where a test can reach it.
 * @module grimoireemoji
 * @author mplx <jennifer@mplx.dev>
 * @license LGPL-3.0-only
 */
use io;
use strings;

import "./emoji.j" as emoji;

exit emoji.run(strings.join(io.readLines(), "\n"));
