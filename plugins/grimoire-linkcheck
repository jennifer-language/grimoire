/**
 * The launcher: hand the request on stdin to `linkcheck.run` and exit its
 * status. Everything else is in the module, where a test can reach it.
 * @module grimoirelinkcheck
 * @author mplx <jennifer@mplx.dev>
 * @license LGPL-3.0-only
 */
use io;
use strings;

import "./linkcheck.j" as linkcheck;

exit linkcheck.run(strings.join(io.readLines(), "\n"));
