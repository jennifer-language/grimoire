/**
 * The launcher: hand the request on stdin to `apiref.run` and exit its status.
 * Everything else is in the module, where a test can reach it.
 * @module grimoireapiref
 * @author mplx <jennifer@mplx.dev>
 * @license LGPL-3.0-only
 */
use io;
use strings;

import "./apiref.j" as apiref;

exit apiref.run(strings.join(io.readLines(), "\n"));
