 * status. Everything else is in the module, where a test can reach it.
 * @module grimoireredirects
 * @author mplx <jennifer@mplx.dev>
 * @license LGPL-3.0-only
 */
use io;
use strings;

import "./redirects.j" as redirects;

exit redirects.run(strings.join(io.readLines(), "\n"));
